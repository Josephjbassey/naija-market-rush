# Copy to .env (never commit .env). Get a Global key: https://3d.aholo.ai/?entry_type=website&auth_action=get_api&from=lux3d
AHOLO_API_KEY=
# LUX3D_MOCK=1                 # test the flow without calling Lux3D
# LUX3D_VERSION=G1-Turbo       # or G1
# LUX3D_STYLE=cartoon          # text-to-3D style: photorealistic, cartoon, anime, hand_painted, ...
# LUX3D_FACE_COUNT=30000       # 10000-300000; lower loads faster in the browser
# MAX_GENERATIONS_PER_HOUR=12  # protects your credits on a public demo
# CORS_ORIGINS=*               # set to your Vercel URL if the frontend is hosted separately
